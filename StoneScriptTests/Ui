/*Foe info box*/                           //max  
disable hud rf

var foeBUTTON = ui.AddButton()
foeBUTTON.x = 18
foeBUTTON.y = 4
foeBUTTON.w = string.Size(foeBUTTON.text) + 2
foeBUTTON.h = 3

var on = 0
var off = 1
var foeBUTTONstate = on
?foeBUTTONstate = on
  draw.Box(60, 19, 32, 8, #333333, 1)
  >`71,19,Foe info
  >`61,20,foe @foe.name@
  >`61,21,S/T @foe.state@|@foe.time@
  >`61,22,Bfs @foe.buffs.string@
  >`61,23,Dfs @foe.debuffs.string@
  >`61,24,Hp @foe.hp@|@foe.maxhp@
  >`61,25,Dmg @foe.damage@
  >`77,21,C/D @foe.count@|@foe.distance@
  >`77,24,Ar @foe.armor@|@foe.maxarmor@
  >`70,25,Lvl @foe.level@
  >`79,25,B/Dc @foe.buffs.count@|
  ^@foe.debuffs.count@

foeBUTTON.text = "disable"
?foeBUTTONstate = off
  foeBUTTON.text = "enable"

func foeBUTTONactivation()
  ?foeBUTTONstate = on
    foeBUTTONstate = off
  :
    foeBUTTONstate = on

foeBUTTON.SetPressed(foeBUTTONactivation)
